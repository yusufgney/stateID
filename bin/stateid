def log(*a):
    print(*a, file=sys.stderr)


# ================================================================ GNOME Shell (D-Bus)
class Shell:
    def __init__(self):
        self.proxy = Gio.DBusProxy.new_for_bus_sync(
            Gio.BusType.SESSION, Gio.DBusProxyFlags.DO_NOT_LOAD_PROPERTIES, None,
            "org.gnome.Shell", DBUS_PATH, DBUS_IFACE, None)

    def call(self, method, sig=None, *args):
        params = GLib.Variant(sig, args) if sig else None
        try:
            res = self.proxy.call_sync(method, params, Gio.DBusCallFlags.NONE, 10000, None)
        except GLib.Error as e:
            sys.exit("Cannot reach the GNOME Shell extension. Is it enabled?\n"
                     "  gnome-extensions info stateid@yusufgney.github.io\n"
                     "(A newly installed extension loads after you log out and back in.)\n" + e.message)
        return res.unpack()[0] if res and res.n_children() else None

    def windows(self):
        return json.loads(self.call("ListWindows"))

    def capture(self, seq, path):
        return self.call("Capture", "(us)", seq, str(path))

    def activate(self, seq):
        return self.call("Activate", "(u)", seq)

    def move_resize(self, seq, r, maximize):
        return self.call("MoveResize", "(uiiiib)", seq, r["x"], r["y"], r["width"], r["height"], maximize)

    def copy(self, text):
        self.call("CopyToClipboard", "(s)", text)

    def notify(self, title, body):
        self.call("Notify", "(ss)", title, body)


# ================================================================ processes
def read_proc(pid, name):
    try:
        if name in ("cwd", "exe"):
            return os.readlink(f"/proc/{pid}/{name}")
        return Path(f"/proc/{pid}/{name}").read_text()
    except OSError:
        return None


def cmdline(pid):
    raw = read_proc(pid, "cmdline")
    return [a for a in raw.split("\0") if a] if raw else []


def children(pid):
    out = []
    for task in glob.glob(f"/proc/{pid}/task/*/children"):
        try:
            out += [int(c) for c in Path(task).read_text().split()]
        except OSError:
            pass
    return out


def descendants(pid, depth=4):
    if depth == 0:
        return []
    out = []
    for c in children(pid):
        out.append(c)
        out += descendants(c, depth - 1)
    return out


def tty_of(pid):
    try:
        t = os.readlink(f"/proc/{pid}/fd/0")
        return t if t.startswith("/dev/pts/") else None
    except OSError:
        return None


def foreground(pid):
    """Foreground process of the terminal `pid` is attached to."""
    try:
        tpgid = int(Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[5])
        return tpgid if tpgid > 0 else pid
    except (OSError, ValueError, IndexError):
        return pid


SKIP_PARTS = {".cache", ".config", ".local", ".mozilla", ".pki", "snap", ".var", ".vscode", "node_modules", ".git"}


def user_files(pids):
    """Documents the processes hold open (not libraries, caches or std streams)."""
    found = []
    for pid in pids:
        for fd in glob.glob(f"/proc/{pid}/fd/*"):
            if fd.rsplit("/", 1)[1] in ("0", "1", "2"):
                continue
            try:
                p = os.readlink(fd)
            except OSError:
                continue
            if not p.startswith(("/home/", "/media/", "/mnt/")) or p.endswith(" (deleted)"):
                continue
            parts = Path(p).parts
            if SKIP_PARTS & set(parts) or any(x.startswith(".") for x in parts[3:]) or not os.path.isfile(p):
                continue
            if p not in found:
                found.append(p)
    return found


def file_arg_docs(cmd):
    return [os.path.abspath(a) for a in cmd[1:] if not a.startswith("-") and os.path.isfile(a)]


def recent_files():
    """GTK's recently-used list, newest first: most apps record every document they open here."""
    try:
        root = ET.parse(HOME / ".local/share/recently-used.xbel").getroot()
    except (OSError, ET.ParseError):
        return []
    items = []
    for b in root.iter("bookmark"):
        href = b.get("href", "")
        if href.startswith("file://"):
            items.append((b.get("visited") or b.get("modified") or "", unquote(urlparse(href).path)))
    return [p for _, p in sorted(items, reverse=True)]


FILENAME_RE = re.compile(r"[^/\\:*?\"<>|()]+\.[A-Za-z0-9]{1,8}")


def files_from_title(title, cwd):
    """Resolve document names shown in a window title, e.g. "settings.yml (~/project) - Text Editor"."""
    title = re.sub(r"^[\s•*●]+", "", title or "")
    hints = [os.path.expanduser(h) for h in re.findall(r"\(([~/][^)]*)\)", title)]
    names = []
    for seg in re.split(r"\s+[-—–|]\s+|\s*\([^)]*\)\s*", title):
        seg = seg.strip(" •*●")
        if FILENAME_RE.fullmatch(seg) and seg not in names:
            names.append(seg)
    if not names:
        return []
    recent = None
    found = []
    for name in names:
        hit = next((os.path.join(h, name) for h in hints if os.path.isfile(os.path.join(h, name))), None)
        if hit is None:
            recent = recent if recent is not None else recent_files()
            hit = next((p for p in recent if os.path.basename(p) == name and os.path.isfile(p)), None)
        if hit is None and cwd and os.path.isfile(os.path.join(cwd, name)):
            hit = os.path.join(cwd, name)
        if hit:
            found.append(hit)
    return found


def spawn(cmd, cwd=None):
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
                     cwd=cwd if cwd and os.path.isdir(cwd) else HOME)
    log("  launched:", shlex.join(cmd))


# ================================================================ .desktop launchers
DESKTOP_DIRS = [HOME / ".local/share/applications", Path("/usr/share/applications"),
                Path("/usr/local/share/applications"), Path("/var/lib/snapd/desktop/applications"),
                Path("/var/lib/flatpak/exports/share/applications"),
                HOME / ".local/share/flatpak/exports/share/applications"]


def find_desktop(app_id):
    if not app_id:
        return None
    return next((str(p / app_id) for p in DESKTOP_DIRS if (p / app_id).exists()), None)


def desktop_command(app_id, files):
    """The app's own Exec line with the documents filled in.

    Running Exec directly (instead of D-Bus activation, which `gio launch` uses for
    DBusActivatable apps) always opens a window, even when the app has no document.
    """
    path = find_desktop(app_id)
    if not path:
        return None
    kf = GLib.KeyFile()
    try:
        kf.load_from_file(path, GLib.KeyFileFlags.NONE)
        exec_ = kf.get_string("Desktop Entry", "Exec")
        if not files:  # prefer an explicit "new window" action when there is nothing to open
            for group in kf.get_groups()[0]:
                if group.startswith("Desktop Action") and "new-window" in group.lower():
                    exec_ = kf.get_string(group, "Exec")
                    break
    except GLib.Error:
        return None
    cmd = []
    for arg in shlex.split(exec_):
        if arg in ("%U", "%F"):
            cmd += files
        elif arg in ("%u", "%f"):
            cmd += files[:1]
        elif arg in ("%i", "%c", "%k", "%d", "%D", "%n", "%N", "%v", "%m"):
            continue
        else:
            cmd.append(arg.replace("%%", "%"))
    return cmd


# ================================================================ accessibility tree (AT-SPI)
Atspi.set_timeout(1500, 1500)
S = Atspi.StateType
TOGGLE_ROLES = {"toggle button", "radio button", "check box", "push button"}
VALUE_ROLES = {"scroll bar", "slider", "spin button"}
TEXT_ROLES = {"entry", "spin button"}
SKIP_TOGGLE = re.compile(r"menu|close|minimi|maximi|search|show open tabs", re.I)


def a11y_frame(pid, title):
    """The AT-SPI frame of a window: same pid, best title match."""
    try:
        desk = Atspi.get_desktop(0)
        best = None
        for i in range(desk.get_child_count()):
            app = desk.get_child_at_index(i)
            if not app or app.get_process_id() != pid:
                continue
            for j in range(app.get_child_count()):
                f = app.get_child_at_index(j)
                if not f:
                    continue
                if (f.get_name() or "").strip() == (title or "").strip():
                    return f
                best = best or f
        return best
    except GLib.Error:
        return None


def a11y_text(node, limit):
    t = node.get_text_iface()
    if not t:
        return None
    n = Atspi.Text.get_character_count(t)
    return Atspi.Text.get_text(t, max(0, n - limit), n)


def a11y_walk(root, max_nodes=5000, seconds=3.0):
    """Yield (path, node, role, name, states) for showing nodes; path is a stable-ish signature."""
    end = time.time() + seconds
    stack = [(root, ())]
    count = 0
    while stack and count < max_nodes and time.time() < end:
        node, path = stack.pop()
        count += 1
        try:
            role, name = node.get_role_name(), node.get_name() or ""
            ss = node.get_state_set()
            if not ss.contains(S.SHOWING) and node is not root:
                continue
            yield path, node, role, name, ss
            seen = {}
            kids = []
            for i in range(node.get_child_count()):
                c = node.get_child_at_index(i)
                if c is None:
                    continue
                key = (c.get_role_name(), c.get_name() or "")
                seen[key] = seen.get(key, -1) + 1
                kids.append((c, path + (key + (seen[key],),)))
            stack.extend(reversed(kids))
        except GLib.Error:
            continue


def is_editor(role, ss):
    return role in ("text", "document text", "terminal") and ss.contains(S.MULTI_LINE) and ss.contains(S.EDITABLE)


def a11y_capture(frame, terminal_chars=4000):
    """Generic UI state: pressed tools, selected tabs, scroll/slider values, field texts,
    text cursors of editors, terminal screens."""
    if frame is None:
        return None
    toggles, tabs, values, texts, carets, terminals = [], [], [], [], [], []
    for path, node, role, name, ss in a11y_walk(frame):
        on = ss.contains(S.CHECKED) or ss.contains(S.PRESSED)
        if role in TOGGLE_ROLES and on and not ss.contains(S.HAS_POPUP) and not SKIP_TOGGLE.search(name):
            toggles.append({"path": path, "role": role, "name": name})
        elif role == "page tab" and ss.contains(S.SELECTED):
            tabs.append({"path": path, "name": name})
        if role in VALUE_ROLES and (v := node.get_value_iface()):
            values.append({"path": path, "role": role, "name": name, "value": Atspi.Value.get_current_value(v),
                           "max": Atspi.Value.get_maximum_value(v)})
        if role == "terminal" and (t := a11y_text(node, terminal_chars)) is not None:
            terminals.append({"text": t.rstrip()})
        elif is_editor(role, ss) and (ti := node.get_text_iface()):
            caret = Atspi.Text.get_caret_offset(ti)
            n = Atspi.Text.get_character_count(ti)
            before = Atspi.Text.get_text(ti, 0, max(0, caret))
            carets.append({"path": path, "caret": caret, "chars": n, "line": before.count("\n") + 1,
                           "column": len(before) - (before.rfind("\n") + 1) + 1,
                           "focused": ss.contains(S.FOCUSED)})
        elif (role in TEXT_ROLES or role == "text") and ss.contains(S.EDITABLE) \
                and (t := a11y_text(node, 300)) and "\n" not in t:  # GTK3 entries have role "text"
            texts.append({"name": name, "text": t})
    return {k: v for k, v in (("toggles", toggles), ("tabs", tabs), ("values", values), ("texts", texts),
                              ("carets", carets), ("terminals", terminals)) if v}


def a11y_apply(frame, ui):
    """Re-press tools, reselect tabs, restore scroll positions and text cursors."""
    if frame is None or not ui:
        return []
    want = {tuple(map(tuple, t["path"])): ("toggle", t) for t in ui.get("toggles", [])}
    want.update({tuple(map(tuple, t["path"])): ("tab", t) for t in ui.get("tabs", [])})
    want.update({tuple(map(tuple, v["path"])): ("value", v) for v in ui.get("values", []) if v["role"] != "spin button"})
    carets = {tuple(map(tuple, c["path"])): c for c in ui.get("carets", [])}
    editors, done = [], []
    for path, node, role, name, ss in a11y_walk(frame):
        if is_editor(role, ss):
            editors.append((path, node))
        hit = want.get(path)
        if not hit:
            continue
        kind, rec = hit
        try:
            if kind == "toggle" and not (ss.contains(S.CHECKED) or ss.contains(S.PRESSED)):
                if (act := node.get_action_iface()) and Atspi.Action.do_action(act, 0):
                    done.append(f"pressed '{name}'")
            elif kind == "tab" and not ss.contains(S.SELECTED):
                if (act := node.get_action_iface()) and Atspi.Action.do_action(act, 0):
                    done.append(f"selected tab '{name}'")
            elif kind == "value" and (v := node.get_value_iface()):
                cur_max = Atspi.Value.get_maximum_value(v)
                target = rec["value"] * cur_max / rec["max"] if rec.get("max") and cur_max else rec["value"]
                Atspi.Value.set_current_value(v, target)
        except GLib.Error:
            pass
    # text cursors: same path if the layout is identical, otherwise the editors in order
    for i, c in enumerate(ui.get("carets", [])):
        node = next((n for p, n in editors if p == tuple(map(tuple, c["path"]))), None)
        if node is None and i < len(editors):
            node = editors[i][1]
        if node is None or c["caret"] <= 0 or not (ti := node.get_text_iface()):
            continue
        try:
            if Atspi.Text.get_character_count(ti) >= c["caret"] and Atspi.Text.set_caret_offset(ti, c["caret"]):
                done.append(f"cursor at line {c['line']}, column {c['column']}")
        except GLib.Error:
            pass
    return done


# ================================================================ app adapters
class Adapter:
    """capture() fills st["app_state"] / st["restore_cmd"]; apply() runs once the window is back."""
    pattern = None
    single_window = False  # match an open window by app alone (its title changes with content)

    def capture(self, w, st):
        pass

    def apply(self, st, win, shell):
        return []

    def launch(self, st, shell):
        return False


# ---------------------------------------------------------------- OnlyOffice (Chromium debug port)
def cdp_targets():
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{ONLYOFFICE_PORT}/json/list", timeout=2) as r:
            return [t for t in json.load(r) if t.get("type") == "page" and "api/documents" in t["url"]]
    except Exception:
        return None


def cdp_eval(ws_url, expr, timeout=30):
    import websockets

    async def run():
        async with websockets.connect(ws_url, max_size=50_000_000, open_timeout=5) as ws:
            await ws.send(json.dumps({"id": 1, "method": "Runtime.evaluate", "params": {
                "expression": expr, "returnByValue": True, "awaitPromise": True}}))
            while True:
                m = json.loads(await ws.recv())
                if m.get("id") == 1:
                    r = m.get("result", {})
                    if "exceptionDetails" in r:
                        raise RuntimeError(r["exceptionDetails"].get("text"))
                    return r.get("result", {}).get("value")
    return asyncio.run(asyncio.wait_for(run(), timeout))


OO_PRELUDE = r"""
const f = [...document.querySelectorAll('iframe')].find(i => /editor\/main\//.test(i.src));
const w = f && f.contentWindow, a = w && (w.editor || (w.Asc && w.Asc.editor));
const app = w && (w.PE || w.DE || w.SSE || w.PDFE || w.VE);
const ctl = n => { try { return app.getController(n); } catch (e) { return null; } };
const sleep = ms => new Promise(r => setTimeout(r, ms));
"""

OO_CAPTURE = "(() => {" + OO_PRELUDE + r"""
if (!a) return null;
const s = {path: w.AscDesktopEditor ? w.AscDesktopEditor.LocalFileGetSourcePath() : null,
           saved: w.AscDesktopEditor ? w.AscDesktopEditor.LocalFileGetSaved() : null};
try { s.page = a.getCurrentPage(); s.pages = a.getCountPages(); } catch (e) {}
try { s.sheet = a.asc_getActiveWorksheetIndex(); } catch (e) {}
try { const tb = ctl('Toolbar').toolbar;
      s.tab = [...new Set([...w.document.querySelectorAll('[data-tab]')].map(e => e.getAttribute('data-tab')))]
                .find(t => tb.isTabActive(t)) || null; } catch (e) {}
try {
  const v = ctl('Common.Controllers.Draw').view, i = v.btnsPen.findIndex(b => b.pressed);
  if (i >= 0) { const o = v.btnsPen[i].options.penOptions;
    s.pen = {index: i, color: o.color, sizeIdx: o.size.idx, size: o.size.arr[o.size.idx], opacity: o.opacity}; }
  if (v.btnEraser && v.btnEraser.pressed) s.eraser = true;
} catch (e) {}
try {
  const dp = ctl('Viewport').getView('DocumentPreview');
  if (dp && dp.isVisible()) s.slideshow = {slide: dp.pages.get('current'), tool: dp.currentDrawTool || null,
                                           color: dp.currentDrawColor};
} catch (e) {}
return s; })()"""

OO_APPLY = "(async (s) => {" + OO_PRELUDE + r"""
for (let i = 0; i < 100 && !(a && a.getCountPages && a.getCountPages() > 0); i++) await sleep(200);
if (!a) return 'editor not ready';
const done = [];
const dp = ctl('Viewport') && ctl('Viewport').getView('DocumentPreview');
if (dp && dp.isVisible() && !s.slideshow) { a.EndDemonstration && a.EndDemonstration(); await sleep(500); }
if (s.sheet != null && a.asc_showWorksheet) { a.asc_showWorksheet(s.sheet); done.push('sheet ' + (s.sheet + 1)); }
if (s.page != null && a.goToPage) { a.goToPage(s.page); done.push('page ' + (s.page + 1)); }
if (s.tab) { try { ctl('Toolbar').toolbar.setTab(s.tab); done.push('tab ' + s.tab); } catch (e) {} }
const draw = ctl('Common.Controllers.Draw');
if (s.pen && draw && draw.view) {
  const b = draw.view.btnsPen[s.pen.index], o = b.options.penOptions;
  o.color = s.pen.color; if (s.pen.sizeIdx != null) o.size.idx = s.pen.sizeIdx;
  draw.view.updateButtonHint && draw.view.updateButtonHint(b);
  b.toggle(true, true); draw.view.depressButtons(b); draw.onDrawPen(b);
  done.push('pen ' + (s.pen.index + 1) + ' color ' + JSON.stringify(s.pen.color));
} else if (s.eraser && draw && draw.view) {
  draw.view.btnEraser.toggle(true, true); draw.onEraser(draw.view.btnEraser); done.push('eraser');
} else if (draw && draw.view && (draw.view.btnsPen.some(b => b.pressed) || (draw.view.btnEraser && draw.view.btnEraser.pressed))) {
  a.asc_StopInkDrawer(); draw.view.depressButtons(); done.push('drawing tool off');
}
if (s.slideshow) {
  if (!(dp && dp.isVisible())) { w.Common.NotificationCenter.trigger('preview:start', s.slideshow.slide, false, false, false); }
  for (let i = 0; i < 50 && !(dp && dp.isVisible()); i++) await sleep(100);
  await sleep(800);
  if (a.DemonstrationGoToSlide) a.DemonstrationGoToSlide(s.slideshow.slide);
  done.push('slideshow at slide ' + (s.slideshow.slide + 1));
  if (s.slideshow.color) dp.currentDrawColor = s.slideshow.color;
  if (s.slideshow.tool) {
    const it = dp.btnDraw.menu.items.find(i => i.value === s.slideshow.tool);
    if (it && dp.currentDrawTool !== it.value) { it.setChecked(true); dp.onDrawMenuItemClick(null, it); }
    done.push(s.slideshow.tool + ' #' + s.slideshow.color);
  }
}
return done.join(', '); })"""


def oo_docs():
    """{path: (target, state)} for every document open in OnlyOffice, or None if the port is closed."""
    targets = cdp_targets()
    if targets is None:
        return None
    out = {}
    for t in targets:
        try:
            s = cdp_eval(t["webSocketDebuggerUrl"], OO_CAPTURE, timeout=5)
        except Exception:
            continue
        if s and s.get("path"):
            out[s["path"]] = (t, s)
    return out


class OnlyOffice(Adapter):
    pattern = re.compile(r"onlyoffice|desktopeditors", re.I)
    single_window = True
    desktop = "onlyoffice-desktopeditors_onlyoffice-desktopeditors.desktop"

    def _open(self, paths):
        cmd = desktop_command(self.desktop, paths) or ["onlyoffice-desktopeditors"] + paths
        spawn(cmd)

    def capture(self, w, st):
        docs = oo_docs()
        active = re.sub(r"\s*[—-]\s*ONLYOFFICE.*$", "", w["title"] or "").strip()
        if docs is None:
            st["app_state"] = {"warning": f"OnlyOffice debug port {ONLYOFFICE_PORT} is closed; start OnlyOffice "
                                          "from the app menu (see install.sh) so slides and pens can be read"}
            return
        state = [dict(s, active=os.path.basename(p) == active) for p, (_, s) in docs.items()]
        state.sort(key=lambda s: not s["active"])
        st["app_state"] = {"documents": state}
        st["files"] = list(dict.fromkeys([s["path"] for s in state] + st["files"]))

    def launch(self, st, shell):
        docs = [d["path"] for d in (st["app_state"] or {}).get("documents", []) if os.path.exists(d["path"])]
        self._open(docs[::-1])
        return True

    def apply(self, st, win, shell):
        docs_state = (st["app_state"] or {}).get("documents", [])
        if not docs_state:
            return []
        done = []
        deadline = time.time() + 60
        pending = {d["path"]: d for d in docs_state if os.path.exists(d["path"])}
        missing = [p for p in pending if p not in (oo_docs() or {})]
        if missing:
            self._open(missing)
        while pending and time.time() < deadline:
            open_docs = oo_docs()
            if open_docs is None:
                time.sleep(1)
                continue
            for path in [p for p in pending if p in open_docs]:
                d = pending.pop(path)
                try:
                    r = cdp_eval(open_docs[path][0]["webSocketDebuggerUrl"], f"{OO_APPLY}({json.dumps(d)})")
                    done.append(f"{os.path.basename(path)}: {r}")
                except Exception as e:
                    done.append(f"{os.path.basename(path)}: failed ({e})")
            time.sleep(1)
        done += [f"{os.path.basename(p)}: did not open in time" for p in pending]
        active = next((d["path"] for d in docs_state if d.get("active")), None)
        if active:  # opening an already-open file switches OnlyOffice to its tab
            self._open([active])
        return done


# ---------------------------------------------------------------- Chromium-family browsers (session files)
BROWSERS = {
    "brave": ("~/.config/BraveSoftware/Brave-Browser", "brave-browser", "Brave"),
    "chrome": ("~/.config/google-chrome", "google-chrome", "Google Chrome"),
    "chromium": ("~/.config/chromium", "chromium", "Chromium"),
}


def snss_windows(path):
    """Parse a Chromium SNSS session file into [{tabs: [{url, title, pinned}], active}]."""
    data = Path(path).read_bytes()
    if data[:4] != b"SNSS":
        return []
    pos, tabs, wins = 8, {}, {}

    def tab(t):
        return tabs.setdefault(t, {"window": None, "index": 0, "navs": {}, "sel": 0, "closed": False, "pinned": False})

    def win(w):
        return wins.setdefault(w, {"selected": 0, "closed": False})

    while pos + 2 <= len(data):
        size, = struct.unpack_from("<H", data, pos)
        pos += 2
        if size == 0 or pos + size > len(data):
            break
        cid, p = data[pos], data[pos + 1:pos + size]
        pos += size
        try:
            if cid == 0:  # SetTabWindow
                w, t = struct.unpack_from("<ii", p); tab(t)["window"] = w; win(w)
            elif cid == 2:  # SetTabIndexInWindow
                t, i = struct.unpack_from("<ii", p); tab(t)["index"] = i
            elif cid == 6:  # UpdateTabNavigation (pickled)
                t, idx, n = struct.unpack_from("<iii", p, 4)
                url = p[16:16 + n].decode("utf-8", "replace")
                o = 16 + ((n + 3) & ~3)
                n16, = struct.unpack_from("<i", p, o)
                tab(t)["navs"][idx] = (url, p[o + 4:o + 4 + 2 * n16].decode("utf-16-le", "replace"))
            elif cid == 7:  # SetSelectedNavigationIndex
                t, i = struct.unpack_from("<ii", p); tab(t)["sel"] = i
            elif cid == 8:  # SetSelectedTabInIndex
                w, i = struct.unpack_from("<ii", p); win(w)["selected"] = i
            elif cid == 12:  # SetPinnedState
                t, b = struct.unpack_from("<i?", p); tab(t)["pinned"] = b
            elif cid == 16:  # TabClosed
                tab(struct.unpack_from("<i", p)[0])["closed"] = True
            elif cid == 17:  # WindowClosed
                win(struct.unpack_from("<i", p)[0])["closed"] = True
        except struct.error:
            pass
    out = []
    for w, wd in wins.items():
        if wd["closed"]:
            continue
        ts = sorted(((td["index"], td) for td in tabs.values() if td["window"] == w and not td["closed"] and td["navs"]),
                    key=lambda x: x[0])
        items = []
        for _, td in ts:
            url, title = td["navs"].get(td["sel"]) or td["navs"][max(td["navs"])]
            items.append({"url": url, "title": title, "pinned": td["pinned"]})
        if items:
            out.append({"tabs": items, "active": min(wd["selected"], len(items) - 1)})
    return out


class Chromium(Adapter):
    pattern = re.compile(r"brave|google-chrome|chromium", re.I)

    def _browser(self, w):
        key = (w["app_id"] or w["wm_class"] or "").lower()
        return next((v for k, v in BROWSERS.items() if k in key), BROWSERS["chrome"])

    def capture(self, w, st):
        base, exe, suffix = self._browser(w)
        title = re.sub(rf" - {re.escape(suffix)}( - .*)?$", "", w["title"] or "")
        best = None
        for f in sorted(glob.glob(os.path.expanduser(base) + "/*/Sessions/Session_*"), key=os.path.getmtime, reverse=True):
            for win in snss_windows(f):
                if win["tabs"][win["active"]]["title"] == title:
                    best = (f, win)
                    break
            if best:
                break
        if not best:
            st["app_state"] = {"active_tab_title": title, "warning": "tab list not in the session files yet"}
            return
        f, win = best
        profile = Path(f).parent.parent.name
        st["app_state"] = {"profile": profile, "active_tab": win["active"], "tabs": win["tabs"]}
        urls = [t["url"] for t in win["tabs"] if not t["url"].startswith(("chrome://newtab", "about:blank"))]
        st["restore_cmd"] = [exe, f"--profile-directory={profile}", "--new-window"] + urls


# ---------------------------------------------------------------- terminals
class Terminal(Adapter):
    pattern = re.compile(r"ptyxis|gnome-terminal|org\.gnome\.terminal|kgx|console", re.I)

    def capture(self, w, st):
        frame = a11y_frame(w["pid"], w["title"])
        shells = []
        for pid in descendants(w["pid"], 3):
            tty, stat = tty_of(pid), read_proc(pid, "stat")
            ppid = int(stat.rsplit(")", 1)[1].split()[1]) if stat else 0
            if not tty or tty_of(ppid) == tty:
                continue  # keep only the top process on each tty (the shell)
            fg = foreground(pid)
            shells.append({"pid": pid, "tty": tty, "cwd": read_proc(fg, "cwd") or read_proc(pid, "cwd"),
                           "command": " ".join(cmdline(fg))})
        titles, subtitle = [], None
        if frame is not None:
            for path, node, role, name, ss in a11y_walk(frame):
                if role == "terminal":
                    parent = node.get_parent() and node.get_parent().get_parent()
                    titles.append((parent.get_name() if parent else "") or w["title"])
                elif role == "label" and name.startswith(("~", "/")) and subtitle is None:
                    subtitle = name

        def score(s, title):  # does the shell's command or directory show in the tab title?
            cmd = os.path.basename(s["command"].split(" ")[0]) if s["command"] else ""
            d = s["cwd"].replace(str(HOME), "~") if s["cwd"] else ""
            return (bool(cmd) and cmd in title) * 2 + (bool(d) and d in title)

        titles = titles or [w["title"]]
        shells.sort(key=lambda s: int(s["tty"].rsplit("/", 1)[1]))
        if w.get("app_window_count", 1) <= 1:
            mine = shells  # the only window of this terminal app owns every shell, hidden tabs too
        else:  # several windows share one process: keep the shells that match this window's visible tabs
            mine = []
            for title in titles:
                cand = sorted((s for s in shells if s not in mine), key=lambda s: score(s, title), reverse=True)
                if cand and (score(cand[0], title) or len(titles) == 1):
                    mine.append(cand[0])
        tabs = []
        for s in mine:
            title = max(titles, key=lambda t: score(s, t))
            tabs.append({"title": title if score(s, title) else None, "cwd": s["cwd"], "running": s["command"]})
        st["app_state"] = {"tabs": tabs or [{"title": t, "cwd": None, "running": None} for t in titles]}
        if subtitle:
            st["app_state"]["current_dir_label"] = subtitle
        if (st.get("ui") or {}).get("terminals"):
            st["app_state"]["screen"] = st["ui"]["terminals"][-1]["text"][-2500:]
        dirs = [t["cwd"] or str(HOME) for t in st["app_state"]["tabs"]] or [str(HOME)]
        if "ptyxis" in (w["app_id"] or "").lower():
            st["restore_cmd"] = ["ptyxis", "--new-window", "-d", dirs[0]]
            st["restore_more"] = [["ptyxis", "--tab", "-d", d] for d in dirs[1:]]
        else:
            cmd = ["gnome-terminal", "--window", f"--working-directory={dirs[0]}"]
            for d in dirs[1:]:
                cmd += ["--tab", f"--working-directory={d}"]
            st["restore_cmd"] = cmd


# ---------------------------------------------------------------- Nautilus
class Nautilus(Adapter):
    pattern = re.compile(r"nautilus", re.I)

    def capture(self, w, st):
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SESSION)
            r = bus.call_sync("org.freedesktop.FileManager1", "/org/freedesktop/FileManager1",
                              "org.freedesktop.DBus.Properties", "Get",
                              GLib.Variant("(ss)", ("org.freedesktop.FileManager1", "OpenWindowsWithLocations")),
                              None, 0, 3000, None).unpack()[0]
        except GLib.Error:
            return
        for locs in r.values():
            paths = [unquote(urlparse(u).path) for u in locs]
            if paths and (os.path.basename(paths[0].rstrip("/")) == w["title"] or paths[0] == str(HOME) and w["title"] == "Home"):
                st["app_state"] = {"locations": paths}
                st["restore_cmd"] = ["nautilus", "--new-window", paths[0]]
                return


# ---------------------------------------------------------------- Evince
class Evince(Adapter):
    pattern = re.compile(r"evince|papers", re.I)

    def capture(self, w, st):
        docs = st["files"]
        if not docs:
            return
        page = None
        texts = (st.get("ui") or {}).get("texts", [])
        for t in sorted(texts, key=lambda t: t["name"] != "page-label-entry"):  # the page entry in the header bar
            if re.fullmatch(r"\d+", t["text"].strip()):
                page = int(t["text"])
                break
        st["app_state"] = {"document": docs[0], "page": page}
        st["restore_cmd"] = ["evince"] + (["-i", str(page)] if page else []) + [docs[0]]


# ---------------------------------------------------------------- VS Code
class VSCode(Adapter):
    pattern = re.compile(r"^code|visual studio code", re.I)

    def capture(self, w, st):
        title = re.sub(r"\s*[-—]\s*Visual Studio Code.*$", "", w["title"] or "")
        parts = [p.strip("● ").strip() for p in re.split(r"\s+[-—]\s+", title) if p.strip()]
        folder_name = parts[-1] if parts else None
        best = None
        for wsj in glob.glob(str(HOME / ".config/Code/User/workspaceStorage/*/workspace.json")):
            try:
                uri = json.loads(Path(wsj).read_text()).get("folder") or ""
            except Exception:
                continue
            path = unquote(urlparse(uri).path)
            if folder_name and os.path.basename(path.rstrip("/")) == folder_name:
                mtime = os.path.getmtime(Path(wsj).parent)
                if not best or mtime > best[0]:
                    best = (mtime, path)
        active = parts[0] if len(parts) > 1 else None
        active_path = None
        if best and active:
            for root, dirs, files in os.walk(best[1]):
                dirs[:] = [d for d in dirs if not d.startswith(".") and d not in ("node_modules", "build", "dist")]
                if active in files:
                    active_path = os.path.join(root, active)
                    break
        st["app_state"] = {"folder": best[1] if best else None, "active_file": active_path or active}
        if best:
            st["restore_cmd"] = ["code", best[1]] + (["-g", active_path] if active_path else [])


ADAPTERS = [OnlyOffice(), Chromium(), Terminal(), Nautilus(), Evince(), VSCode()]


def adapter_for(w):
    key = " ".join(filter(None, [w.get("app_id"), w.get("wm_class"), w.get("gtk_app_id")]))
    return next((a for a in ADAPTERS if a.pattern.search(key)), Adapter())


# ================================================================ save
def describe_window(w):
    pid = w["pid"]
    cmd = cmdline(pid) if pid > 0 else []
    cwd = read_proc(pid, "cwd") if pid > 0 else None
    pids = [pid] + descendants(pid, 2) if pid > 0 else []
    st = {
        "window": w,
        "app": w["app_name"] or w["wm_class"],
        "command": cmd,
        "cwd": cwd,
        "files": list(dict.fromkeys(files_from_title(w["title"], cwd) + file_arg_docs(cmd) + user_files(pids))),
        "unsaved": bool(re.match(r"^\s*[•*●]", w["title"] or "")),
        "app_state": None,
        "restore_cmd": None,
    }
    try:
        st["ui"] = a11y_capture(a11y_frame(pid, w["title"])) if pid > 0 else None
    except Exception as e:
        st["ui"] = None
        log(f"accessibility read failed for {st['app']}: {e}")
    try:
        adapter_for(w).capture(w, st)
    except Exception as e:  # an adapter failing must not lose the snapshot
        st["app_state"] = {"error": f"{type(e).__name__}: {e}"}
    return st


def new_id():
    while True:
        n = secrets.randbits(40)
        kid = "DK-" + "".join(ALPHABET[(n >> (5 * i)) & 31] for i in range(8))
        if not (STORE / kid).exists():
            return kid


def agent_md(kid, states, created):
    lines = [f"# State {kid}", "",
             f"Saved {created}. This is the user's desktop at that moment. Each window has a screenshot "
             "(`windowN.png`) in this folder; look at it for anything not captured as data.", "",
             f"Restore with: `stateid restore {kid}`", ""]
    for i, st in enumerate(states, 1):
        w, r = st["window"], st["window"]["rect"]
        lines += [f"## {i}. {st['app']} — {w['title']}", ""]
        lines.append(f"- Placement: workspace {w['workspace']}, {r['width']}x{r['height']} at {r['x']},{r['y']}"
                     + (" (maximized)" if w["maximized"] else "") + (" (minimized)" if w["minimized"] else "")
                     + (" — **focused window**" if w["focused"] else ""))
        if st.get("unsaved"):
            lines.append("- **Has unsaved changes** (title marker)")
        if st["cwd"]:
            lines.append(f"- Working directory: `{st['cwd']}`")
        if st["files"]:
            lines.append("- Open files: " + ", ".join(f"`{f}`" for f in st["files"][:15]))
        a = st["app_state"] or {}
        screen = a.pop("screen", None) if isinstance(a, dict) else None
        for d in a.get("documents", []) if isinstance(a, dict) else []:
            desc = f"slide/page {d['page'] + 1}/{d.get('pages')}" if d.get("page") is not None else ""
            if d.get("pen"):
                desc += f", pen {d['pen']['index'] + 1} selected (color {d['pen']['color']})"
            if d.get("slideshow"):
                ss = d["slideshow"]
                desc += f", SLIDESHOW running at slide {ss['slide'] + 1}" + (f" with {ss['tool']} #{ss['color']}" if ss.get("tool") else "")
            lines.append(f"- {'**active** ' if d.get('active') else ''}`{d['path']}`: {desc}")
        if isinstance(a, dict) and a.get("tabs") and "active_tab" in a:
            t = a["tabs"][a["active_tab"]]
            lines.append(f"- Browser: {len(a['tabs'])} tabs, active: {t['title']} <{t['url']}>")
        if a:
            lines.append("- App state:")
            lines += ["  ```json", *["  " + l for l in json.dumps(a, ensure_ascii=False, indent=1).splitlines()[:80]], "  ```"]
        ui = st.get("ui") or {}
        for c in ui.get("carets", []):
            lines.append(f"- Text cursor: line {c['line']}, column {c['column']}" + (" (focused)" if c["focused"] else ""))
        if ui.get("toggles"):
            lines.append("- Active tools/toggles: " + ", ".join(f"`{t['name']}`" for t in ui["toggles"][:20] if t["name"]))
        if ui.get("tabs"):
            lines.append("- Selected tabs: " + ", ".join(f"`{t['name']}`" for t in ui["tabs"]))
        if ui.get("texts"):
            lines.append("- Text fields: " + ", ".join(f"`{t['name'] or '?'}`=`{t['text'][:80]}`" for t in ui["texts"][:10]))
        if screen:
            lines += ["- Terminal screen (end):", "  ```", *["  " + l for l in screen.splitlines()[-40:]], "  ```"]
        if st.get("screenshot"):
            lines.append(f"- Screenshot: `{STORE / kid / st['screenshot']}`")
        lines.append("")
    return "\n".join(lines)


def cmd_save(args):
    shell = Shell()
    wins = shell.windows()
    for w in wins:
        w["app_window_count"] = sum(o["app_id"] == w["app_id"] for o in wins)
    if args.window is not None:
        wins = [w for w in wins if w["seq"] == args.window]
    elif args.focused:
        wins = [w for w in wins if w["focused"]]
    if not wins:
        sys.exit("Window not found")
    kid = new_id()
    d = STORE / kid
    d.mkdir(parents=True)
    states = []
    for i, w in enumerate(sorted(wins, key=lambda w: (not w["focused"], -w["user_time"]))):
        st = describe_window(w)
        png = f"window{i + 1}.png"
        if shell.capture(w["seq"], d / png):
            st["screenshot"] = png
        states.append(st)
    created = datetime.now().isoformat(timespec="seconds")
    (d / "state.json").write_text(json.dumps(
        {"id": kid, "version": VERSION, "created": created,
         "scope": "window" if args.window is not None or args.focused else "desktop",
         "windows": states}, ensure_ascii=False, indent=1))
    (d / "AGENT.md").write_text(agent_md(kid, json.loads(json.dumps(states)), created))
    if args.copy:
        shell.copy(kid)
        names = ", ".join(s["app"] or "?" for s in states[:3]) + ("…" if len(states) > 3 else "")
        shell.notify(f"State ID copied: {kid}", f"{len(states)} window(s): {names}")
    print(kid)


# ================================================================ restore
def load(kid):
    kid = kid.strip().upper()
    f = STORE / kid / "state.json"
    if not f.exists():
        sys.exit(f"No such state: {kid}  (see `stateid list`)")
    return json.loads(f.read_text())


def launch(st, adapter, shell):
    if adapter.launch(st, shell):
        return True
    if st.get("restore_cmd"):
        spawn(st["restore_cmd"], st["cwd"])
        for extra in st.get("restore_more", []):
            time.sleep(1.0)
            spawn(extra, st["cwd"])
        return True
    docs = [f for f in st["files"] if os.path.exists(f)][:5] or files_from_title(st["window"]["title"], st["cwd"])
    cmd = desktop_command(st["window"]["app_id"], docs)
    if cmd:
        spawn(cmd, st["cwd"])
        if not docs:
            log("  note: no document was recorded for this window; the app opens empty (see the screenshot)")
        return True
    if st["command"] and "--gapplication-service" not in st["command"]:
        spawn(st["command"], st["cwd"])
        return True
    return False


def same_app(a, b):
    return (a["app_id"] and a["app_id"] == b["app_id"]) or (a["wm_class"] and a["wm_class"] == b["wm_class"])


def cmd_restore(args):
    data = load(args.id)
    shell = Shell()
    current = shell.windows()
    known = {c["seq"] for c in current}
    used = set()
    placed = []  # (state, adapter, window or None)
    for st in data["windows"]:
        w = st["window"]
        ad = adapter_for(w)
        same = [c for c in current if c["seq"] not in used and same_app(c, w)]
        match = next((c for c in same if c["title"] == w["title"]), None)
        if match is None and ad.single_window and same:
            match = same[0]
        print(f"• {st['app']} — {w['title']}")
        if match:
            used.add(match["seq"])
            print("  already open")
            placed.append((st, ad, match))
        elif launch(st, ad, shell):
            placed.append((st, ad, None))
        else:
            print("  cannot reopen: no launcher found for this app")
    # wait for relaunched windows, then put every window back where it was
    deadline = time.time() + WINDOW_WAIT
    while any(win is None for _, _, win in placed) and time.time() < deadline:
        time.sleep(0.5)
        for c in shell.windows():
            if c["seq"] in known:
                continue
            for i, (st, ad, win) in enumerate(placed):
                if win is None and same_app(c, st["window"]):
                    placed[i] = (st, ad, c)
                    known.add(c["seq"])
                    break
    time.sleep(1.0)
    for st, ad, win in placed:
        w = st["window"]
        if win is None:
            print(f"  {st['app']}: the window did not appear within {WINDOW_WAIT}s")
            continue
        if not w.get("fullscreen"):  # fullscreen windows (e.g. a slideshow) are recreated by the app
            shell.move_resize(win["seq"], w["rect"], w["maximized"])
        done = []
        try:
            done += ad.apply(st, win, shell)
        except Exception as e:
            done.append(f"app restore failed: {e}")
        if st.get("ui"):
            for attempt in range(6):  # the document may still be loading
                try:
                    fresh = next((c for c in shell.windows() if c["seq"] == win["seq"]), win)
                    got = a11y_apply(a11y_frame(fresh["pid"], fresh["title"]), st["ui"])
                except Exception as e:
                    got = [f"accessibility restore failed: {e}"]
                if got or not st["ui"].get("carets"):
                    done += got
                    break
                time.sleep(0.5)
        if done:
            print(f"  {st['app']}: " + "; ".join(done))
        tabs = (st["app_state"] or {}).get("tabs", []) if isinstance(st["app_state"], dict) else []
        for t in tabs:
            if isinstance(t, dict) and t.get("running") and t.get("cwd") is not None \
                    and not re.fullmatch(r"-?(ba|z|fi)?sh", os.path.basename(t["running"].split()[0])):
                print(f"  was running in {t['cwd']}: {t['running']}")
        if st.get("unsaved"):
            print(f"  {st['app']}: had unsaved changes when saved; check the app's own draft recovery")
    focused = next((st for st in data["windows"] if st["window"]["focused"]), None)
    if focused:
        win = next((win for st, _, win in placed if st is focused and win), None)
        if win:
            shell.activate(win["seq"])
    print(f"\nAgent summary: {STORE / data['id'] / 'AGENT.md'}")


def cmd_show(args):
    data = load(args.id)
    print((STORE / data["id"] / "AGENT.md").read_text())


def cmd_list(args):
    rows = []
    for f in STORE.glob("DK-*/state.json"):
        try:
            d = json.loads(f.read_text())
        except Exception:
            continue
        names = ", ".join(f"{s['app']}: {s['window']['title']}"[:60] for s in d["windows"][:2])
        rows.append((d["created"], d["id"], len(d["windows"]), names))
    if not rows:
        print("No saved states yet. Create one with `stateid save`.")
    for created, kid, n, names in sorted(rows, reverse=True)[: args.n]:
        print(f"{kid}  {created.replace('T', ' ')}  {n:>2} window(s)  {names}")


def cmd_delete(args):
    for kid in args.id:
        data = load(kid)
        shutil.rmtree(STORE / data["id"])
        print("deleted:", data["id"])


# ================================================================ command line
DESCRIPTION = """\
stateid gives the current state of your open windows a short ID (like DK-7SZKSJV0)
and brings that exact moment back later: the same apps, documents, pages, tools,
tabs, folders, cursor positions and window placement. Hand the ID to an AI agent
and it can read what you were doing with `stateid show`.

Ways to create an ID without the terminal:
  * right-click a window's title bar, or Super + right-click anywhere in a window,
    and choose "Copy state ID of this window" / "... of the whole desktop"
  * press Super+Shift+S (whole desktop)
The ID is copied to the clipboard and a notification shows it."""

EPILOG = """\
what is saved, per window:
  every app       title, placement, workspace, screenshot, working directory,
                  open documents (from the process, the title and recent files),
                  pressed tool buttons, selected tabs, scroll positions,
                  text-field contents and text cursor (line/column)
  OnlyOffice      every open document, current slide/page, active toolbar tab,
                  selected pen and its colour, eraser, running slideshow + its pen
  Brave/Chrome    all tabs of the window with their URLs and the active tab
  Ptyxis/Terminal every tab's directory, the command running in it, screen text
  Nautilus        the folder shown
  Evince          document and page
  VS Code         project folder and active file

examples:
  stateid save --copy             snapshot the whole desktop, copy the ID
  stateid save --focused          snapshot only the window you are using
  stateid list                    find an ID
  stateid DK-7SZKSJV0             go back to that moment
  stateid show DK-7SZKSJV0        what an agent should read to continue

files: states live in ~/.local/share/stateid/<ID>/ (state.json, AGENT.md, windowN.png);
set STATEID_DIR to use another folder."""


def build_parser():
    p = argparse.ArgumentParser(prog="stateid", description=DESCRIPTION, epilog=EPILOG,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    sub = p.add_subparsers(dest="command", metavar="<command>", title="commands")

    s = sub.add_parser("save", help="snapshot the open windows and print a new state ID",
                       description="Snapshot open windows (all of them by default) and print the new state ID. "
                                   "Each window gets a screenshot plus everything stateid can read about the "
                                   "app's internal state.")
    g = s.add_mutually_exclusive_group()
    g.add_argument("--window", type=int, metavar="SEQ",
                   help="only the window with this sequence number (as used by the window menu)")
    g.add_argument("--focused", action="store_true", help="only the window that has the keyboard focus")
    s.add_argument("--copy", action="store_true", help="also copy the ID to the clipboard and show a notification")
    s.set_defaults(fn=cmd_save)

    s = sub.add_parser("restore", help="bring a saved moment back (shortcut: stateid ID)",
                       description="Reopen what is closed, reuse what is already open, put every window back in "
                                   "place and re-apply the saved app state (pages, tools, tabs, cursor...). "
                                   "Commands that were running in terminals are printed, not re-run.")
    s.add_argument("id", help="a state ID such as DK-7SZKSJV0")
    s.set_defaults(fn=cmd_restore)

    s = sub.add_parser("show", help="print the summary an agent should read to continue the work",
                       description="Print AGENT.md for a state: windows, documents, app state, terminal screens "
                                   "and paths to the screenshots.")
    s.add_argument("id", help="a state ID")
    s.set_defaults(fn=cmd_show)

    s = sub.add_parser("list", help="list saved states, newest first",
                       description="List saved states, newest first, with the first windows of each.")
    s.add_argument("-n", type=int, default=20, metavar="N", help="how many to show (default: 20)")
    s.set_defaults(fn=cmd_list)

    s = sub.add_parser("delete", help="delete saved states", description="Delete one or more saved states.")
    s.add_argument("id", nargs="+", help="state IDs")
    s.set_defaults(fn=cmd_delete)
    return p


def main():
    argv = sys.argv[1:]
    if len(argv) == 1 and ID_RE.match(argv[0].strip().upper()):
        argv = ["restore", argv[0]]
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "fn", None):
        parser.print_help()
        return
    args.fn(args)


if __name__ == "__main__":
    main()
